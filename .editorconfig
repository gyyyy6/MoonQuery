# EditorConfig: https://editorconfig.org
# Keeps every editor producing the same bytes as the MoonBit toolchain.

root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

# Two trailing spaces are a hard line break in Markdown, keep them.
[*.md]
trim_trailing_whitespace = false

# MoonBit sources (moon fmt already writes LF + 2 spaces).
[*.{mbt,mbti}]
indent_size = 2

[Makefile]
indent_style = tab